<Page
    x:Class="EasyDisk.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="6" MaxWidth="600" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ToggleSwitch x:Name="ThemeSwitch" Header="深色主题" Toggled="ThemeSwitch_Toggled" />
                    <ToggleSwitch x:Name="MicaSwitch" Header="背景毛玻璃（Mica 云母）" Toggled="MicaSwitch_Toggled" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="删除" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ToggleSwitch x:Name="RecycleSwitch"
                                  Header="删除时移入回收站（关闭则为永久删除）"
                                  Toggled="RecycleSwitch_Toggled" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" FontWeight="SemiBold" />
                    <TextBlock Text="EasyDisk v1.0.0 — 磁盘分析 + 文件秒搜" Opacity="0.8" />
                    <TextBlock Text="文件名秒搜依赖本机 Everything；未安装时可使用自建索引。"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
