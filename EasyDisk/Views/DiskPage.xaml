<Page
    x:Class="EasyDisk.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyDisk.Views">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="磁盘分析" FontSize="26" FontWeight="SemiBold" />

        <!-- 第一行：位置选择 + 操作按钮 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="位置" VerticalAlignment="Center" />
            <ComboBox x:Name="DriveBox" Grid.Column="1" SelectionChanged="DriveBox_SelectionChanged" />
            <Button x:Name="ScanButton" Grid.Column="2" Content="扫描" Click="Scan_Click" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="强制刷新" Click="Refresh_Click" />
            <Button x:Name="BackButton" Grid.Column="4" Content="返回上层" Click="Back_Click" IsEnabled="False" />
        </Grid>

        <!-- 第二行：系统目录开关 + 状态 -->
        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleSwitch x:Name="ShowSystemSwitch"
                          Header="显示系统目录"
                          OffContent="已隐藏（防误删）"
                          OnContent="显示（不可删除）"
                          Toggled="ShowSystemSwitch_Toggled"
                          IsOn="False" />

            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ProgressBar x:Name="ScanProgress" Grid.Row="2" VerticalAlignment="Bottom"
                     Visibility="Collapsed" />

        <!-- 结果列表 -->
        <ListView x:Name="FolderList" Grid.Row="3"
                  SelectionMode="Single"
                  SelectionChanged="FolderList_SelectionChanged"
                  DoubleTapped="FolderList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="#33FF5555" CornerRadius="4" Padding="5,1"
                                    Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="系统保护" FontSize="11" Foreground="#FF5555" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding Summary}" FontSize="12" Opacity="0.7" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                     Value="{Binding Percent}" Maximum="100" Height="5" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
            <Button x:Name="DeleteButton" Content="删除选中文件夹" Click="Delete_Click" IsEnabled="False" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>
